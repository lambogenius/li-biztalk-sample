<?xml version="1.0" encoding="utf-8"?>
<xsl:stylesheet version="2.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:inv="http://HarborLane.Integration.Schemas.InventoryFlatFile" xmlns:out="http://HarborLane.Integration.Schemas.InventoryUpdate" exclude-result-prefixes="inv xs">
  <xsl:output method="xml" omit-xml-declaration="yes"/>
  <xsl:template match="/inv:InventoryFile"><out:InventoryUpdate><Warehouse><xsl:value-of select="Header/WarehouseCode"/></Warehouse><SnapshotDate><xsl:call-template name="format-date"><xsl:with-param name="value" select="Header/SnapshotDate"/></xsl:call-template></SnapshotDate><Items><xsl:for-each select="Detail"><Item><Sku><xsl:value-of select="Sku"/></Sku><Description><xsl:value-of select="Description"/></Description><Location><xsl:value-of select="BinLocation"/></Location><OnHand><xsl:value-of select="QuantityOnHand"/></OnHand><ReorderPoint><xsl:value-of select="ReorderPoint"/></ReorderPoint></Item></xsl:for-each></Items></out:InventoryUpdate></xsl:template>
  <xsl:template name="format-date"><xsl:param name="value"/><xsl:choose><xsl:when test="string-length($value)=8 and translate($value, '0123456789', '')='' and concat(substring($value,1,4), '-', substring($value,5,2), '-', substring($value,7,2)) castable as xs:date"><xsl:value-of select="concat(substring($value,1,4), '-', substring($value,5,2), '-', substring($value,7,2))"/></xsl:when><xsl:otherwise><xsl:value-of select="$value"/></xsl:otherwise></xsl:choose></xsl:template>
</xsl:stylesheet>
