<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Helper library called from the HarborLane.Integration orchestrations.
    BizTalk Server 2020 loads it from the GAC, so it targets .NET Framework 4.8.
    To deploy it to BizTalk, sign it with your own key (see README.md); no key is committed.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>HarborLane.Integration.Helpers</RootNamespace>
    <AssemblyName>HarborLane.Integration.Helpers</AssemblyName>
    <Version>1.0.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Company>Harbor Lane Supply (fictional)</Company>
    <Product>HarborLane.Integration</Product>
    <LangVersion>7.3</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="Exists('..\..\HarborLane.snk')">
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\..\HarborLane.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Xml" />
  </ItemGroup>

</Project>
