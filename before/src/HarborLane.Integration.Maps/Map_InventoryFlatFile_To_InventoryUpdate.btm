          </Input-Parameters>
          <ScripterCode>
            <Script Language="CSharp"><![CDATA[// Warehouse snapshot files carry the date as yyyyMMdd; downstream systems expect yyyy-MM-dd.
public string FormatSnapshotDate(string snapshotDate)
{
    System.DateTime parsed;
    if (System.DateTime.TryParseExact(snapshotDate, "yyyyMMdd", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out parsed))
    {
        return parsed.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);
    }
    return snapshotDate;
}]]></Script>
          </ScripterCode>
        </Functoid>
