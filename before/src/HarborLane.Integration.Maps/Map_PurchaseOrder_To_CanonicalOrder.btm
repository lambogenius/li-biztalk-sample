          </Input-Parameters>
          <ScripterCode>
            <Script Language="CSharp"><![CDATA[// Retail partners send the order date as yyyyMMdd; the canonical order uses xs:date (yyyy-MM-dd).
public string FormatOrderDate(string orderDate)
{
    System.DateTime parsed;
    if (System.DateTime.TryParseExact(orderDate, "yyyyMMdd", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out parsed))
    {
        return parsed.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);
    }
    return orderDate;
}]]></Script>
          </ScripterCode>
