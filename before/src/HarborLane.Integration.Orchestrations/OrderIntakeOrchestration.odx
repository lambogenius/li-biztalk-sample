[Microsoft.XLANGs.BaseTypes.BPELExportable(false)]
module HarborLane.Integration.Orchestrations
{
    internal porttype PortType_PurchaseOrderIn
    {
        oneway Operation_ReceivePurchaseOrder
        {
            HarborLane.Integration.Schemas.PurchaseOrder
        };
    };
    internal porttype PortType_CanonicalOrderOut
    {
        oneway Operation_SendCanonicalOrder
        {
            HarborLane.Integration.Schemas.CanonicalOrder
        };
    };
    internal porttype PortType_OrderErrorOut
    {
        oneway Operation_SendOrderError
        {
            HarborLane.Integration.Schemas.OrderError
        };
    };
    [Microsoft.XLANGs.BaseTypes.BPELExportable(false)]
    internal service OrderIntakeOrchestration
    {
        [Microsoft.XLANGs.BaseTypes.LogicalBinding()]
        port implements PortType_PurchaseOrderIn ReceivePurchaseOrderPort;
        [Microsoft.XLANGs.BaseTypes.LogicalBinding()]
        port uses PortType_CanonicalOrderOut SendApprovalPort;
        [Microsoft.XLANGs.BaseTypes.LogicalBinding()]
        port uses PortType_CanonicalOrderOut SendFulfilmentPort;
        [Microsoft.XLANGs.BaseTypes.LogicalBinding()]
        port uses PortType_OrderErrorOut SendErrorPort;
        message HarborLane.Integration.Schemas.PurchaseOrder PurchaseOrderMsg;
        message HarborLane.Integration.Schemas.CanonicalOrder CanonicalOrderMsg;
        message HarborLane.Integration.Schemas.CanonicalOrder PricedOrderMsg;
        message HarborLane.Integration.Schemas.OrderError OrderErrorMsg;
        System.Decimal discountAmount;
        System.Decimal netTotal;
        body ()
        {
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("8c7e1ce4-1f6a-409c-a92a-6290897a732b")]
            activate receive (ReceivePurchaseOrderPort.Operation_ReceivePurchaseOrder, PurchaseOrderMsg);
            discountAmount = 0;
            netTotal = 0;
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("1c280d3e-561c-40e0-97a1-1805aa7ea77c")]
            scope
            {
                body
                {
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("8870709a-5246-4639-8dec-62fd576ff7e5")]
                    construct CanonicalOrderMsg
                    {
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("c9073b80-ed71-4a1d-b70a-78f8d5ae640b")]
                        transform (CanonicalOrderMsg) = HarborLane.Integration.Maps.Map_PurchaseOrder_To_CanonicalOrder (PurchaseOrderMsg);
                    }
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("59df1065-9bfa-4f9b-8a24-877a2c302ef5")]
                    discountAmount = HarborLane.Integration.Helpers.PricingRules.CalculateDiscount(CanonicalOrderMsg.OrderTotal, CanonicalOrderMsg.CustomerTier);
                    netTotal = CanonicalOrderMsg.OrderTotal - discountAmount;
