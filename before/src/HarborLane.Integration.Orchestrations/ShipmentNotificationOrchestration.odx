[Microsoft.XLANGs.BaseTypes.BPELExportable(false)]
module HarborLane.Integration.Orchestrations
{
    internal porttype PortType_ShipmentNoticeService
    {
        requestresponse Operation_SubmitNotice
        {
            HarborLane.Integration.Schemas.ShipmentNotice, HarborLane.Integration.Schemas.ShipmentAck
        };
    };
    internal porttype PortType_ShipmentNoticeOut
    {
        oneway Operation_ArchiveNotice
        {
            HarborLane.Integration.Schemas.ShipmentNotice
        };
    };
    [Microsoft.XLANGs.BaseTypes.BPELExportable(false)]
    internal service ShipmentNotificationOrchestration
    {
        [Microsoft.XLANGs.BaseTypes.LogicalBinding()]
        port implements PortType_ShipmentNoticeService ShipmentNoticePort;
        [Microsoft.XLANGs.BaseTypes.LogicalBinding()]
        port uses PortType_ShipmentNoticeOut SendShipmentArchivePort;
        message HarborLane.Integration.Schemas.ShipmentNotice ShipmentNoticeMsg;
        message HarborLane.Integration.Schemas.ShipmentAck ShipmentAckMsg;
        System.Boolean isValid;
        System.String estimatedDelivery;
        body ()
        {
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("d1d0ea0e-7c30-447a-b96c-9af1948c2765")]
            activate receive (ShipmentNoticePort.Operation_SubmitNotice, ShipmentNoticeMsg);
            isValid = false;
            estimatedDelivery = "";
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("89eabd48-046c-40a9-9e38-29da4cca3750")]
            isValid = HarborLane.Integration.Helpers.ShipmentRules.IsValidNotice(ShipmentNoticeMsg.ShipmentId, ShipmentNoticeMsg.TrackingNumber, ShipmentNoticeMsg.PackageCount);
            estimatedDelivery = HarborLane.Integration.Helpers.DeliveryCalendar.EstimateDeliveryDate(ShipmentNoticeMsg.ShipDate, ShipmentNoticeMsg.ServiceLevel);
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("6a2500f4-e96f-4b04-a5ad-aaa92c3ca95f")]
            construct ShipmentAckMsg
            {
                [Microsoft.XLANGs.BaseTypes.DesignerPosition("778b029d-f23e-4ca6-9de5-290e310bb8ff")]
                transform (ShipmentAckMsg) = HarborLane.Integration.Maps.Map_ShipmentNotice_To_ShipmentAck (ShipmentNoticeMsg);
                [Microsoft.XLANGs.BaseTypes.DesignerPosition("f0e6d40c-29ce-430a-998d-3979e4f31d8a")]
                ShipmentAckMsg.Status = HarborLane.Integration.Helpers.ShipmentRules.AckStatus(isValid);
                ShipmentAckMsg.EstimatedDelivery = estimatedDelivery;
            }
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("118abb97-6f4f-4807-b594-e26b58244db7")]
            send (ShipmentNoticePort.Operation_SubmitNotice, ShipmentAckMsg);
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("d3fe9ade-e0c0-4eaf-8597-6e8755d8337a")]
            if (isValid == true)
            {
                [Microsoft.XLANGs.BaseTypes.DesignerPosition("e666384c-8ef4-40ec-a88f-d2c16bfc9712")]
                send (SendShipmentArchivePort.Operation_ArchiveNotice, ShipmentNoticeMsg);
            }
        }
    }
}
